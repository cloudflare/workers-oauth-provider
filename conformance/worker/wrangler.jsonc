{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mcp-oauth-conformance-worker",
  "main": "index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "mcp-oauth-conformance-kv",
    },
  ],
  // The Worker binds to itself so a test can run a resource server whose validator is the
  // authorization server's `validateToken` reached over a Service Binding, exactly as the
  // docs show for two Workers.
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "mcp-oauth-conformance-worker",
    },
  ],
}
