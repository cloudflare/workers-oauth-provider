{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "mcp-server",
  "main": "index.ts",
  "compatibility_date": "2026-07-29",
  // Reachable only on its custom domain, which matches the configured issuer or resource.
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.example.com", "custom_domain": true }],
  // Tokens are validated by calling the auth-server Worker's validateToken() over this binding.
  "services": [{ "binding": "AUTH_SERVER", "service": "auth-server" }],
  // Builds against this repository's source. Delete this in your own project.
  "alias": { "@cloudflare/workers-oauth-provider": "../../../src/oauth-provider.ts" },
}
